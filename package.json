{
  "name": "@axiscommunications/vaas-sdk",
  "version": "0.0.3",
  "description": "Axis Video as a Service (VaaS) SDK",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "workspaces": [
    "demo"
  ],
  "scripts": {
    "build": "tsup src/index.ts --config tsup.config.ts",
    "fix": "biome check . --apply-unsafe && biome format . --write",
    "lint-ci": "npm run build && biome ci . && cd demo && tsc",
    "demo": "npm ci && npm run build && cd demo && npm run demo",
    "local-pack": "./scripts/local-pack.sh"
  },
  "author": "Axis Communications AB",
  "collaborators": [
    "Axis Communications AB"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@biomejs/biome": "1.6.4",
    "@microsoft/api-documenter": "7.24.1",
    "@microsoft/api-extractor": "7.43.0",
    "@types/lodash.merge": "4.6.9",
    "tsup": "8.0.2",
    "type-fest": "4.15.0",
    "typescript": "5.4.4"
  },
  "dependencies": {
    "@lkp-rnd/webrtcvideo": "0.15.1",
    "dpop": "1.4.0",
    "jwt-decode": "4.0.0",
    "lodash.merge": "4.6.2",
    "oidc-client-ts": "3.0.1"
  },
  "files": [
    "dist"
  ]
}