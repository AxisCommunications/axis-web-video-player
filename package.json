{
  "name": "@axiscommunications/axis-vaas-video-player",
  "version": "2.0.0",
  "description": "Axis Video as a Service (VaaS) video player",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --config tsup.config.ts",
    "fix": "biome check . --write --unsafe && biome format . --write",
    "lint-ci": "npm run build && biome ci . && cd example && tsc",
    "docs": "./scripts/generate-docs.sh",
    "example": "npm ci && npm run build && cd example && npm run example",
    "prepublishOnly": "./scripts/prepare-publish.sh"
  },
  "author": "Axis Communications AB",
  "collaborators": [
    "Axis Communications AB"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@microsoft/api-documenter": "7.26.27",
    "@microsoft/api-extractor": "7.52.8",
    "@types/lodash.merge": "4.6.9",
    "tsup": "8.5.0",
    "type-fest": "4.41.0",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@axiscommunications/webrtcvideo": "2.7.1",
    "dpop": "1.4.1",
    "jwt-decode": "4.0.0",
    "lodash.merge": "4.6.2",
    "oidc-client-ts": "3.2.1"
  },
  "files": [
    "dist",
    "docs"
  ]
}
