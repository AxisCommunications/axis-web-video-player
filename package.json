{
  "name": "@axiscommunications/axis-web-video-player",
  "version": "1.2.0",
  "description": "Axis Web Video Player",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsdown src/index.ts --config tsdown.config.ts",
    "fix": "biome check . --write --unsafe && biome format . --write",
    "lint-ci": "npm run build && biome ci . && (cd example && tsc) && npm run headers:check",
    "headers:check": "tsx scripts/copyright-headers.ts check src/ example/",
    "headers:fix": "tsx scripts/copyright-headers.ts fix src/ example/",
    "docs": "./scripts/generate-docs.sh",
    "example": "npm ci && npm run build && cd example && npm run example",
    "prepublishOnly": "./scripts/prepare-publish.sh"
  },
  "author": "Axis Communications AB",
  "collaborators": [
    "Axis Communications AB"
  ],
  "license": "MIT",
  "repository": {
    "url": "https://github.com/AxisCommunications/axis-web-video-player.git",
    "type": "git"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@microsoft/api-documenter": "7.30.7",
    "@microsoft/api-extractor": "7.58.9",
    "@types/lodash.merge": "4.6.9",
    "@types/node": "^26.0.1",
    "tsdown": "^0.22.3",
    "tsx": "^4.22.4",
    "type-fest": "5.7.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@axiscommunications/webrtcvideo": "2.23.0"
  },
  "bundleDependencies": [
    "@axiscommunications/webrtcvideo"
  ],
  "files": [
    "dist",
    "docs"
  ]
}