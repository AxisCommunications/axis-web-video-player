{
  "name": "@axiscommunications/axis-vaas-video-player",
  "version": "1.0.0",
  "description": "Axis Video as a Service (VaaS) video player",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "workspaces": [
    "demo"
  ],
  "scripts": {
    "build": "tsup src/index.ts --config tsup.config.ts",
    "fix": "biome check . --write --unsafe && biome format . --write",
    "lint-ci": "npm run build && biome ci . && cd demo && tsc",
    "docs": "./scripts/generate-docs.sh",
    "demo": "npm ci && npm run build && cd demo && npm run demo",
    "prepublishOnly": "./scripts/prepare-publish.sh"
  },
  "author": "Axis Communications AB",
  "collaborators": [
    "Axis Communications AB"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@biomejs/biome": "1.9.2",
    "@microsoft/api-documenter": "7.25.14",
    "@microsoft/api-extractor": "7.47.9",
    "@types/lodash.merge": "4.6.9",
    "tsup": "8.3.0",
    "type-fest": "4.26.1",
    "typescript": "5.6.2"
  },
  "dependencies": {
    "@axiscommunications/webrtcvideo": "1.5.0",
    "dpop": "1.4.1",
    "jwt-decode": "4.0.0",
    "lodash.merge": "4.6.2",
    "oidc-client-ts": "3.0.1"
  },
  "files": [
    "dist",
    "docs"
  ]
}
